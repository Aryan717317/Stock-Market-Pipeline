# Replace every replace-with value. Do not commit .env.
ALPHA_VANTAGE_API_KEY=replace-with-your-free-api-key
STOCK_SYMBOLS=IBM
STOCK_DB_PASSWORD=replace-with-a-strong-database-password
AIRFLOW_DB_PASSWORD=replace-with-a-different-database-password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-ui-password
# Use at least 32 random characters, shared by all Airflow services.
AIRFLOW_JWT_SECRET=replace-with-at-least-32-random-characters
AIRFLOW_UI_PORT=8080
# Applies before each HTTP attempt. Keep this within your provider's quota.
API_MIN_INTERVAL_SECONDS=15
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
